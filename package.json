{
  "name": "sahne-cad",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:tek": "tsc --noEmit && vite build --mode tek",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/engine.test.ts",
    "test:ui": "node tests/ui_smoke.mjs http://127.0.0.1:4173/ shots && node tests/ui_flows.mjs http://127.0.0.1:4173/ shots && node tests/ui_power.mjs http://127.0.0.1:4173/ shots && node tests/ui_linecheck.mjs http://127.0.0.1:4173/ shots",
    "release": "npm run build:tek && node scripts/release.mjs",
    "docs:shots": "node tests/docs_shots.mjs http://127.0.0.1:4173/ docs",
    "icons": "node scripts/icons.mjs",
    "pages": "bash scripts/pages.sh"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "immer": "^11.1.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
